#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the Claude Code Fastify server (ACP client + static SPA host).
# ==============================================================================

# Read user-configurable options from the add-on config and export them as
# environment variables for the server.
export LOG_LEVEL="$(bashio::config 'log_level')"
export WORKING_DIRECTORY="$(bashio::config 'working_directory')"

bashio::log.info "Starting Claude Code server (log_level=${LOG_LEVEL}, working_directory=${WORKING_DIRECTORY})"

exec node /app/server/dist/index.js
