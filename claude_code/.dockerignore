# Keep the Docker build context small. The image runs `npm ci` + `npm run build`
# itself, so host node_modules/dist are not needed (web/dist is built in-image).
**/node_modules
**/dist
*.tsbuildinfo

.git
.gitignore

# Persistent data / local state
data
/data

# Playwright / E2E artifacts (not needed in the image)
e2e/test-results
e2e/playwright-report
e2e/.cache

# Misc
.DS_Store
*.log
.env
.env.*
